# Virtual environment (created by install.py)
/.venv/

# Python bytecode
__pycache__/
*.pyc

# Generated at install time: the start file for the platform installed on,
# and the Linux app-menu entry
/open-eew
/open-eew.bat
/open-EE-workbench.desktop

# Runtime output — generated per run, not source
/results/*
!/results/.gitkeep
/src/custom_tests/
/src/workbenches/bench_*.json
