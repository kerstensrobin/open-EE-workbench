# Virtual environment (created by install.py)
/.venv/

# Python bytecode
__pycache__/
*.pyc

# Generated at install time: the start file for the platform installed on,
# and the Linux app-menu entry
/open-eew
/open-eew.bat
/open-EE-workbench.desktop

# Runtime output — generated per run, not source
/results/*
!/results/.gitkeep
/src/custom_tests/

# Workbench profiles are per-machine/per-bench state, not source — never commit
# these except the demo workbench, which ships with the app.
/src/workbenches/*.json
!/src/workbenches/demo.json
